FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY pyproject.toml setup.py ./
COPY finrl_pro ./finrl_pro
COPY conf ./conf

RUN pip install --upgrade pip \
    && pip install --no-cache-dir .[dev]

CMD ["bash"]
