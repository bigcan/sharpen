# GMGP1-v5 Paper Trading — Environment Variables
# Copy to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to git.

# --- IB Gateway Credentials ---
# Your Interactive Brokers username and password
TWS_USERID=
TWS_PASSWORD=

# Trading mode: "paper" or "live"
TRADING_MODE=paper

# VNC password for IB Gateway GUI debugging (optional, leave blank to disable)
VNC_PASSWORD=

# --- WandB Monitoring ---
# Get your API key from https://wandb.ai/authorize
WANDB_API_KEY=
