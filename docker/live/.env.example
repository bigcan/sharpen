# FinRL Multi-Strategy — Environment Variables
# Copy to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to git.

# --- Paths ---
# Checkpoints are bind-mounted at runtime (too large to bake into image).
# Configs are baked into the image at build time — no CONFIG_DIR needed.
# Use absolute paths for production reliability.
# Windows example: C:/FinRL/FinRL-Pro_DS/checkpoints
# Relative (from docker/live/): ../../checkpoints
CHECKPOINT_DIR=../../checkpoints

# --- IB Gateway Credentials (REQUIRED for IB strategies) ---
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
VNC_PASSWORD=changeme

# --- Bybit API (crypto strategies, leave empty for testnet) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- cTrader API (ctrader strategies) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# --- DXtrade API (velotrade/prop firm strategies) ---
DXTRADE_SERVER=
DXTRADE_USERNAME=
DXTRADE_PASSWORD=
DXTRADE_ACCOUNT_ID=

# --- WandB Monitoring (REQUIRED) ---
WANDB_API_KEY=

# --- Prometheus / Grafana (optional, for monitoring profile) ---
GRAFANA_ADMIN_PASSWORD=finrl
MAX_STALE_SECONDS=600

# --- Watchdog Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated container names the watchdog should ignore (intentionally stopped
# or shelved workstreams). Empty = monitor everything.
IGNORE_CONTAINERS=sync-1h,funding-arb,sg1-gold

# --- PRISM Server (optional, for prism profile) ---
PRISM_DB_PASSWORD=
PRISM_API_KEY=
PRISM_HMM_TICKERS=BTC-USD
