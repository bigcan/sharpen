# FinRL Strategy Engine — CPU-only PyTorch inference
#
# Single image for ALL strategies (IB futures + crypto).
# Configs are baked into the image at build time (COPY configs/).
# Checkpoints are bind-mounted at runtime (too large to bake).
#
# NOTE: Windows Docker Desktop silently fails on bind-mount configs,
# so we rely on the baked copy. Rebuild after config changes:
#   docker compose build engine-base
#
# Build:
#   docker compose build engine-base
#   OR: docker build -t finrl-live-engine:latest -f docker/live/Dockerfile.live-engine .

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    procps \
    tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Dependencies layer (cached) ----
# PyTorch CPU-only (~200MB vs ~2GB CUDA)
RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu

# All strategy dependencies — IB + crypto in one image
RUN pip install \
    "ib-insync>=0.9.86" \
    "ccxt>=4.0.0" \
    "httpx[http2]>=0.27" \
    "websockets>=12.0" \
    "aiohttp>=3.9.0" \
    "stable-baselines3>=2.3.0" \
    "wandb>=0.16.0" \
    "pandas>=2.1.0" \
    "pyarrow>=14.0.1" \
    "pyyaml>=6.0" \
    "numpy>=1.24" \
    "gymnasium>=0.29" \
    "stockstats>=0.6" \
    "scipy>=1.11" \
    "python-dotenv>=1.0" \
    "tzdata>=2024.1" \
    "prometheus_client>=0.20"

# PRISM client SDK (regime detection overlay)
COPY docker/live/prism_sdk/ /tmp/prism_sdk/
RUN pip install /tmp/prism_sdk/ && rm -rf /tmp/prism_sdk/

# ---- Application layer ----
COPY finrl_pro_ds /app/finrl_pro_ds
COPY scripts /app/scripts
COPY configs /app/configs
# v2.2 §8.2 live-monitoring baselines (seed_report.json + ensemble_report.json
# per workstream). Baked at build time so the live engine can resolve
# drift.baseline_path without a volume mount. See baselines/README.md.
COPY baselines /app/baselines
# v2.3 atomic-swap bundles (ensemble_v{N}.tar.gz + .sha256 per workstream).
# Baked so a strategy swap = one image rebuild + container bounce; the
# swap-approval handshake (finrl_pro_ds.live.swap_handshake) gates the load
# against the operator's last-bundle sentinel.
COPY bundles /app/bundles
# sg1-xauusd VS v2 Phase 2 fold7 ensemble ckpts (S543, 2026-05-20). Baked
# rather than bind-mounted because Docker Desktop on Windows silently fails
# to expose bind-mount contents on force-recreate (CLAUDE.md gotcha). Only
# fold 7 is required at runtime (live config agent.ensemble.fold: 7).
COPY checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed2025_20260520_181055 /app/checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed2025_20260520_181055
COPY checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed42_20260520_181055 /app/checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed42_20260520_181055
COPY checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed9999_20260520_181055 /app/checkpoints/sg1-xauusd-vs-v2-phase2-wf-fold7-seed9999_20260520_181055
# sg1-btc DECAY-01 fold_07 seed-456 ckpt + norm_warmup_3-15-60.pkl (S548,
# 2026-05-22). Baked rather than bind-mounted for the Windows force-recreate
# safety reason above. live_sg1_btc_binance.yaml features.norm_warmup_path
# reads the pkl; the .pth itself is unused at runtime (the bundle's seed_456
# checkpoint owns the agent weights), but copying the whole dir keeps the pkl
# co-located with its source ckpt for audit.
COPY checkpoints/sg1-btc-decay01-wf-fold7-seed456_20260521_230637 /app/checkpoints/sg1-btc-decay01-wf-fold7-seed456_20260521_230637
# sg1-eurusd HG L1 trial-18 seed-2025 ckpt + norm_warmup_3-15-60.pkl (S550,
# 2026-05-24). Bundle ensemble_v1 (seeds [2025, 3141, 9999], ens_pf_weighted)
# owns the agent weights at runtime; this dir is COPYed so the per-seed
# norm_warmup pkl is reachable at live_sg1_eurusd_bybit.yaml
# features.norm_warmup_path. The seeds' train_end_date is identical
# (2025-09-30), so any one seed's pkl serves the whole ensemble.
COPY checkpoints/sg1-eurusd-hg-l1-trial18-seed2025_20260523_120312 /app/checkpoints/sg1-eurusd-hg-l1-trial18-seed2025_20260523_120312
COPY pyproject.toml /app/

RUN pip install -e ".[ctrader]"

# ---- Runtime setup ----
# NOTE: COPY from Windows host strips the user-write bit on nested dirs
# (top-level /app/<dir> is 755 but subdirs land 555). The engine extracts
# atomic-swap bundles into /app/bundles/<ws>/_extracted_<stem>/ at boot
# (ensemble_bundle.extract_and_verify_bundle), so /app/bundles MUST be
# writable by finrl. Restore the user-write bit there explicitly.
RUN groupadd -r finrl && useradd -r -g finrl -d /app finrl \
    && mkdir -p /app/logs /app/state /tmp \
    && chown -R finrl:finrl /app /tmp \
    && chmod -R u+w /app/bundles

COPY docker/live/entrypoint.sh /app/entrypoint.sh
COPY docker/live/healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/entrypoint.sh /app/healthcheck.sh

USER finrl

ENV PYTHONPATH=/app

HEALTHCHECK --interval=5m --timeout=10s --start-period=5m --retries=3 \
    CMD /app/healthcheck.sh

ENTRYPOINT ["/app/entrypoint.sh"]
