# FinRL Strategy Engine — CPU-only PyTorch inference
#
# Single image for ALL strategies (IB futures + crypto).
# Configs are baked into the image at build time (COPY configs/).
# Checkpoints are bind-mounted at runtime (too large to bake).
#
# NOTE: Windows Docker Desktop silently fails on bind-mount configs,
# so we rely on the baked copy. Rebuild after config changes:
#   docker compose build engine-base
#
# Build:
#   docker compose build engine-base
#   OR: docker build -t finrl-live-engine:latest -f docker/live/Dockerfile.live-engine .

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    procps \
    tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Dependencies layer (cached) ----
# PyTorch CPU-only (~200MB vs ~2GB CUDA)
RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu

# All strategy dependencies — IB + crypto in one image
RUN pip install \
    "ib-insync>=0.9.86" \
    "ccxt>=4.0.0" \
    "websockets>=12.0" \
    "aiohttp>=3.9.0" \
    "stable-baselines3>=2.3.0" \
    "wandb>=0.16.0" \
    "pandas>=2.1.0" \
    "pyarrow>=14.0.1" \
    "pyyaml>=6.0" \
    "numpy>=1.24" \
    "gymnasium>=0.29" \
    "stockstats>=0.6" \
    "scipy>=1.11" \
    "python-dotenv>=1.0" \
    "tzdata>=2024.1" \
    "prometheus_client>=0.20"

# PRISM client SDK (regime detection overlay)
COPY docker/live/prism_sdk/ /tmp/prism_sdk/
RUN pip install /tmp/prism_sdk/ && rm -rf /tmp/prism_sdk/

# ---- Application layer ----
COPY finrl_pro_ds /app/finrl_pro_ds
COPY scripts /app/scripts
COPY configs /app/configs
# v2.2 §8.2 live-monitoring baselines (seed_report.json + ensemble_report.json
# per workstream). Baked at build time so the live engine can resolve
# drift.baseline_path without a volume mount. See baselines/README.md.
COPY baselines /app/baselines
COPY pyproject.toml /app/

RUN pip install -e ".[ctrader]"

# ---- Runtime setup ----
RUN groupadd -r finrl && useradd -r -g finrl -d /app finrl \
    && mkdir -p /app/logs /app/state /tmp \
    && chown -R finrl:finrl /app /tmp

COPY docker/live/entrypoint.sh /app/entrypoint.sh
COPY docker/live/healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/entrypoint.sh /app/healthcheck.sh

USER finrl

ENV PYTHONPATH=/app

HEALTHCHECK --interval=5m --timeout=10s --start-period=5m --retries=3 \
    CMD /app/healthcheck.sh

ENTRYPOINT ["/app/entrypoint.sh"]
