{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sharpen:crucible:community-funnel-closed-search:v1",
  "title": "Crucible community ledger: one closed signal-funnel search",
  "description": "One pre-registered batch scored by the sharpen.signals funnel: what was searched, how many specs were scored, how strong the test was next to the smallest edge worth having, and whether the question is closed. Counts and spec hashes only; no name, score or per-signal verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "export_id",
    "hypotheses",
    "kind",
    "power",
    "provenance",
    "schema_version",
    "substrate",
    "trials",
    "verdict",
    "verdict_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "funnel_closed_search"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "verdict": {
      "enum": [
        "CLOSED_DECISIVE",
        "OPEN_UNDERPOWERED",
        "PROMISING_FOUND"
      ]
    },
    "verdict_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "promising_result",
          "no_candidate_passed_at_powered_bar",
          "mde_above_floor",
          "planted_control_failed",
          "power_not_measured"
        ]
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_end",
        "data_sources",
        "data_start",
        "id",
        "search_space",
        "universe"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "universe": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "data_start": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "data_end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "search_space": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_multiplicity",
        "gates_sha256_12",
        "preregistered_on",
        "primary_horizon_days"
      ],
      "properties": {
        "preregistered_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "primary_horizon_days": {
          "type": "integer",
          "minimum": 1
        },
        "declared_multiplicity": {
          "type": "integer",
          "minimum": 1
        },
        "gates_sha256_12": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preregistered",
        "promising",
        "scored"
      ],
      "properties": {
        "preregistered": {
          "type": "integer",
          "minimum": 0
        },
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "promising": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection_bar_ic_ir",
        "economic_floor_ic_ir",
        "planted_control_passed"
      ],
      "properties": {
        "detection_bar_ic_ir": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "economic_floor_ic_ir": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "planted_control_passed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_hashes"
      ],
      "properties": {
        "spec_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "funnel",
        "sharpen_version"
      ],
      "properties": {
        "sharpen_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.+-][A-Za-z0-9.+-]+)?$"
        },
        "funnel": {
          "const": "sharpen.signals"
        }
      }
    }
  }
}
