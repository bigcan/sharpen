best_params.yaml
deepscalper_tuned.yaml
trading_state.json
recent_runs.json
deploy_package.zip
deploy_package_*.zip
deploy_dhpo_*.zip
configs/_*_runtime/
env.txt
*.db

# Crucible persistent state (SQLite trial ledger + data catalog; flat files stay authoritative)
*.sqlite
*.sqlite3
.crucible/
crucible_state/

# Docker artifacts
docker/*.log

# Legacy directories (prevent re-creation)
specs/
prompts/
audits/
media/
archive/
.specify/
.idea/

# Agent runtime artifacts
.agent/audits/
.agent/reports/

# Agent memory (ephemeral logs, keep core.md + SKILL.md)
.agent/memory/logs/*
!.agent/memory/logs/.gitkeep
.agent/memory/snapshots/*
!.agent/memory/snapshots/.gitkeep

# Model weights / checkpoints (binary, use DVC or artifact store)
*.pth
*.pt
*.onnx
alphaseek_train/

# Research papers & large data snapshots (don't bloat git history)
*.pdf
*.jsonl
# Exception: live-replay capture fixtures (E1 Tier-3 regression input).
# Small (<1MB), versioned, scrubbed of secrets at pull time.
!tests/fixtures/live_replay/*.jsonl

# Contest data snapshots
contest/*/data/

# OS metadata
.DS_Store
Thumbs.db

# Claude Code local settings and worktrees
.claude/

# Selftest artifact: scripts/research/taiwan_txo_vrp_validation.py writes its report to
# `$TMPDIR/_txo_vrp_validation_selftest`, and TMPDIR is unset on Windows, so the fallback
# is the repo root. Two tests in tests/research invoke it, so a plain test run litters here.
_txo_vrp_validation_selftest/
