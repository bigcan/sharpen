# MCP config (contains API keys) + local rollback/backup variants
.mcp.json*

# Local-pulled backups (Phase-2 off-host copy of agent-memory LanceDB tarballs)
.backups/

# Resolved deploy configs (base + overlay merges, per-deploy artifacts)
configs/deploy/_resolved/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
.eggs/
lib/
